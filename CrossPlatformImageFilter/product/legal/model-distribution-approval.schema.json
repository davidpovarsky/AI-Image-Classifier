{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commercial model distribution approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalId", "models", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "approvalId": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelIdentifier", "sourceRevision", "approvedRuntimeSHA256", "reviewedLicenseFiles",
          "commercialRedistributionApproved", "obligations", "reviewer", "reviewDate",
          "approvalReference", "replacementRequirement"
        ],
        "properties": {
          "modelIdentifier": { "enum": ["mobileCLIP2", "nudeNet", "personDetector"] },
          "sourceRevision": { "type": "string", "minLength": 1 },
          "approvedRuntimeSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reviewedLicenseFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "commercialRedistributionApproved": { "type": "boolean" },
          "obligations": { "type": "array", "items": { "type": "string" } },
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewDate": { "type": "string", "format": "date" },
          "approvalReference": { "type": "string", "minLength": 1 },
          "replacementRequirement": { "type": "string" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "contentEncoding": "base64" }
      }
    }
  }
}
