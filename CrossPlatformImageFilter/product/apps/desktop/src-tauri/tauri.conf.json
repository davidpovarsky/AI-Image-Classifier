{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Image Filter",
  "version": "0.1.0",
  "identifier": "com.localimagefilter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["desktop-main"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Local AI Image Filter",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "hardenedRuntime": true
    },
    "shortDescription": "Local on-device image filtering",
    "longDescription": "Commercial desktop controller for the Local AI Image Filter supervisor service."
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": ["https://updates.localimagefilter.example/v1/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3M0UwQTI1RjY1Qzc3MTIKUldRU2QxejJKUW8rOStlVUhoYk1LSDByVGVtTHJRait0a1duQmRFMnlzWU83eENxdXl3THQwY3oK"
    }
  }
}
